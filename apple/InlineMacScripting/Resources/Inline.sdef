<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Inline Terminology">
  <suite name="Inline Suite" code="Inln" description="Automate the signed-in Inline Mac app. Cached lists are bounded snapshots; public-user search uses the network. IDs are decimal text.">
    <command name="show inline" code="Inlnshow" description="Bring Inline forward, opening a main window if necessary.">
      <cocoa class="InlineScriptCommand"/>
      <result type="boolean"/>
    </command>
    <command name="current account" code="Inlnacct" description="The signed-in account's ID, display name, and username. Never returns credentials or contact details.">
      <cocoa class="InlineScriptCommand"/>
      <result type="record"/>
    </command>
    <command name="list spaces" code="Inlnspcs" description="Cached spaces, ordered by ID. Use start offset to paginate; the cache can change between calls.">
      <cocoa class="InlineScriptCommand"/>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes" description="1–100, default 100."><cocoa key="limit"/></parameter>
      <parameter name="start offset" code="Ioff" type="integer" optional="yes" description="0–1000000, default 0."><cocoa key="offset"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="list users" code="Inlnusrs" description="Cached identities from this account's visible conversations and shared spaces, ordered by ID. No contact details or remote lookup.">
      <cocoa class="InlineScriptCommand"/>
      <parameter name="in space" code="Ispc" type="text" optional="yes" description="Restrict to cached members of a space where this account has cached membership."><cocoa key="spaceID"/></parameter>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes" description="1–100, default 100."><cocoa key="limit"/></parameter>
      <parameter name="start offset" code="Ioff" type="integer" optional="yes"><cocoa key="offset"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="find users" code="Inlnufnd" description="Find known cached identities by literal name or username substring. Optional leading @ is ignored. Does not search email or phone.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Nonblank query, up to 200 UTF-16 units."/>
      <parameter name="in space" code="Ispc" type="text" optional="yes"><cocoa key="spaceID"/></parameter>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes" description="1–100, default 100."><cocoa key="limit"/></parameter>
      <parameter name="start offset" code="Ioff" type="integer" optional="yes"><cocoa key="offset"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="user info" code="Inlnuinf" description="Get one known cached identity by user ID. Never creates a DM or fetches a remote profile.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Stable user ID."/>
      <result type="record"/>
    </command>
    <command name="search public users" code="Inlnusrh" description="Network search for globally discoverable usernames, including owned bots by name. Other bots require an exact username. Results do not imply space membership and are not saved to the local cache.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="2–200 UTF-16 units; optional leading @. Email, phone, and shorter queries yield no results."/>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes" description="1–20, default 20. The server rate-limits discovery."><cocoa key="limit"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="list chats" code="Inlnchat" description="Cached chats with visible dialog membership, ordered by ID. Does not fetch remote chats.">
      <cocoa class="InlineScriptCommand"/>
      <parameter name="in space" code="Ispc" type="text" optional="yes"><cocoa key="spaceID"/></parameter>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes" description="1–100, default 100."><cocoa key="limit"/></parameter>
      <parameter name="start offset" code="Ioff" type="integer" optional="yes"><cocoa key="offset"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="find chats" code="Inlnfind" description="Find cached dialog chats by literal title, name, or username substring. Not a global people search.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Nonblank query, up to 200 UTF-16 units."/>
      <parameter name="in space" code="Ispc" type="text" optional="yes"><cocoa key="spaceID"/></parameter>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes"><cocoa key="limit"/></parameter>
      <parameter name="start offset" code="Ioff" type="integer" optional="yes"><cocoa key="offset"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="current chat" code="Inlncurr" description="The primary chat in the frontmost Inline main window, or missing value. Does not select a reply pane or open a window.">
      <cocoa class="InlineScriptCommand"/>
      <result type="any"/>
    </command>
    <command name="current thread" code="Inlncthr" description="Alias for current selection: the open reply thread, otherwise the primary conversation, in the frontmost visible non-minimized Inline main window; or missing value. DMs are included.">
      <cocoa class="InlineScriptCommand"/>
      <result type="any"/>
    </command>
    <command name="current selection" code="Inlncsel" description="The open reply thread, otherwise the primary conversation, in the frontmost visible non-minimized Inline main window. Returns chat info or missing value. This is conversation selection, not selected text or message rows. Never activates Inline, changes the clipboard, or marks messages read.">
      <cocoa class="InlineScriptCommand"/>
      <result type="any"/>
    </command>
    <command name="open chat" code="Inlnopen" description="Open a cached dialog chat in the frontmost main window and activate Inline. Returns the chat ID after requesting navigation; opening can mark messages read.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Stable chat ID."/>
      <result type="text"/>
    </command>
    <command name="create thread" code="Inlncrth" description="Create a top-level thread and cache the acknowledged chat. Save its chat ID, then send the first message separately. No offline queue, navigation, or retry deduplication. On timeout or error, check Inline before retrying creation.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" optional="yes" description="Optional title, up to 150 UTF-16 units. Empty or omitted means untitled."/>
      <parameter name="in space" code="Ispc" type="text" optional="yes" description="Omit for Home; the server validates space membership."><cocoa key="spaceID"/></parameter>
      <parameter name="participant ids" code="Ipts" optional="yes" description="Up to 100 decimal-text user IDs, deduplicated. The creator is included for private threads. Space participants must be existing members."><cocoa key="participantIDs"/><type type="text" list="yes"/></parameter>
      <parameter name="publicly visible" code="Ipub" type="boolean" optional="yes" description="Default false. True requires a space and no explicit participant IDs."><cocoa key="isPublic"/></parameter>
      <result type="record" description="Created chat info with a stable chat ID. Use send message for its first message."/>
    </command>
    <command name="recent messages" code="Inlnmsgs" description="Cached confirmed messages, newest first. Excludes collapsed history. Does not fetch history or mark it read.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Stable chat ID."/>
      <parameter name="maximum count" code="Ilmt" type="integer" optional="yes" description="1–100, default 20."><cocoa key="limit"/></parameter>
      <parameter name="before message" code="Ibfr" type="text" optional="yes" description="Return message IDs smaller than this ID, for pagination."><cocoa key="beforeID"/></parameter>
      <result><type type="record" list="yes"/></result>
    </command>
    <command name="send message" code="Inlnsend" description="Send Markdown as the signed-in user with server Markdown parsing enabled, including stable-ID mentions. Does not change the draft or queue offline. On timeout delivery may be unknown; inspect the chat and reuse your request ID if supplied.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Nonblank Markdown, up to 4096 UTF-16 units. Use [@Name](inline://user/123) for a stable-ID mention. No attachments or raw entity input."/>
      <parameter name="to chat" code="Icht" type="text" description="Stable cached chat ID; always explicit."><cocoa key="chatID"/></parameter>
      <parameter name="request id" code="Irqi" type="text" optional="yes" description="Positive Int64 decimal text. Reuse only for retries of the same destination and text. Generated if omitted."><cocoa key="requestID"/></parameter>
      <result type="record" description="Acknowledged chat, message, and request IDs."/>
    </command>
    <command name="chat link" code="Inlnlink" description="Build an app deep link to a cached dialog chat, without opening it.">
      <cocoa class="InlineScriptCommand"/>
      <direct-parameter type="text" description="Stable chat ID."/>
      <result type="text"/>
    </command>
    <record-type name="account info" code="Iact">
      <property name="user id" code="Iuid" type="text" access="r"/>
      <property name="display name" code="Inam" type="text" access="r"/>
      <property name="username" code="Iusr" type="text" description="Empty if unset." access="r"/>
    </record-type>
    <record-type name="space info" code="IspR">
      <property name="space id" code="Isid" type="text" access="r"/>
      <property name="title" code="Itit" type="text" access="r"/>
    </record-type>
    <record-type name="user profile" code="IusR">
      <property name="user id" code="Iuid" type="text" access="r"/>
      <property name="display name" code="Inam" type="text" access="r"/>
      <property name="username" code="Iusr" type="text" description="Empty if unset." access="r"/>
      <property name="is bot" code="Ibot" type="boolean" access="r"/>
    </record-type>
    <record-type name="chat info" code="IchR">
      <property name="id" code="ID  " type="text" description="Stable chat ID as decimal text. Alias for chat id." access="r"/>
      <property name="name" code="pnam" type="text" description="Display name. Alias for title." access="r"/>
      <property name="chat id" code="Icid" type="text" access="r"/>
      <property name="title" code="Itit" type="text" access="r"/>
      <property name="URL" code="pURL" type="text" description="Stable chat link using this app build's scheme; independent of the name." access="r"/>
      <property name="markdown link" code="Imlk" type="text" description="Escaped name and URL from the same snapshot for Markdown destinations." access="r"/>
      <property name="chat kind" code="Iknd" type="text" description="private or thread." access="r"/>
      <property name="space id" code="Isid" type="text" description="Empty for Home chats." access="r"/>
      <property name="unread count" code="Iunr" type="integer" access="r"/>
    </record-type>
    <record-type name="message info" code="ImsR">
      <property name="message id" code="Imid" type="text" description="Only unique within its chat." access="r"/>
      <property name="chat id" code="Icid" type="text" access="r"/>
      <property name="sender id" code="Ifrm" type="text" access="r"/>
      <property name="message text" code="Itxt" type="text" description="Empty when a message has no text; media is not exported." access="r"/>
      <property name="sent at" code="Idat" type="real" description="Unix timestamp in seconds." access="r"/>
      <property name="outgoing" code="Iout" type="boolean" access="r"/>
    </record-type>
    <record-type name="send receipt" code="IsnR">
      <property name="chat id" code="Icid" type="text" access="r"/>
      <property name="message id" code="Imid" type="text" access="r"/>
      <property name="send request id" code="Irid" type="text" access="r"/>
    </record-type>
  </suite>
</dictionary>
