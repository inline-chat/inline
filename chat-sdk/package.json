{
  "name": "@inline-chat/chat-sdk",
  "version": "0.1.0",
  "description": "Inline Bot API adapter for Vercel Chat SDK",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inline-chat/inline.git",
    "directory": "chat-sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
