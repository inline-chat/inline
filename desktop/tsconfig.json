{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "electron"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/platform/**/*.ts",
    "src/preload/**/*.ts",
    "scripts/build.ts",
    "scripts/dev.ts"
  ]
}
