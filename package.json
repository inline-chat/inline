{
  "name": "inline",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "server",
    "cli",
    "web",
    "landing",
    "mobile",
    "packages/bot-api",
    "packages/bot-api-types",
    "packages/mcp",
    "packages/oauth-core",
    "packages/openclaw",
    "packages/protocol",
    "packages/sdk",
    "packages/url-preview",
    "server/packages/*",
    "landing/packages/*",
    "scripts"
  ],
  "catalog": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "scripts": {
    "dev": "cd server && bun run dev",
    "dev:server": "cd server && bun run dev",
    "generate:proto": "cd scripts && bun run generate",
    "public:sync": "bun run scripts/sync-public-artifacts.ts",
    "matrix-inline:e2e": "bun run scripts/matrix-inline-e2e.ts",
    "lint:apple": "bash scripts/apple/swiftlint.sh",
    "check:apple": "bash scripts/apple/swiftlint.sh --quiet --reporter summary",
    "db:migrate": "cd server && bun run db:migrate",
    "db:generate": "cd server && bun run db:generate",
    "ios:debug": "bash scripts/ios/open-debug-app.sh",
    "macos:debug": "bash scripts/macos/open-debug-app.sh",
    "macos:grid-logs": "bash scripts/macos/stream-grid-logs.sh",
    "cleanup:builds": "cd scripts && bun run cleanup:builds",
    "cleanup:builds:deep": "cd scripts && bun run cleanup:builds:deep"
  },
  "overrides": {
    "@inline-chat/protocol": "workspace:*",
    "@inline-chat/realtime-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zustand": "^5.0.9"
  }
}
