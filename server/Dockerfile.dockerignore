# This file replaces the root ignore for server builds. Only workspace
# manifests and server dependency sources are needed by the pruner.
**
!package.json
!bun.lock
!bunfig.toml
!cli/
!cli/package.json
!server/
!server/**
!landing/
!landing/package.json
!landing/packages/
!landing/packages/*/
!landing/packages/*/package.json
!packages/
!packages/*/
!packages/*/package.json
!packages/protocol/**
!packages/oauth-core/**
!packages/bot-api-types/**
!plugins/
!plugins/*/
!plugins/*/package.json
!scripts/
!scripts/package.json
!scripts/docker/
!scripts/docker/prune-workspace.ts
!scripts/docker/smoke-artifact.ts

**/.*
!server/Dockerfile.dockerignore
**/node_modules
**/dist
**/target
**/coverage*
**/build
**/*.tsbuildinfo
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.sqlite
**/*.db
**/*.env
**/id_rsa
**/id_ed25519
