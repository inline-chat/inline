{
  "name": "@inline-chat/server",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "NODE_ENV=production bun scripts/build.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun run test:bun && bun run test:effect",
    "test:bun": "bun scripts/test-runner.ts",
    "test:effect": "vitest run --config vitest.effect.config.ts && bun run test:effect:bun",
    "test:effect:bun": "bun test --timeout=30000 ./src/controllers/adminLive.effect.bun.test.ts ./src/controllers/adminParity.effect.bun.test.ts ./src/core/http/productionHost.effect.bun.test.ts",
    "test:postgres": "NODE_ENV=test bun test src/__tests__ --timeout=30000",
    "test:realtime": "NODE_ENV=test bun test src/realtime src/__tests__/realtime.protocol.test.ts src/__tests__/realtime.connectionInit.test.ts src/__tests__/handlers --timeout=30000",
    "test:shutdown": "NODE_ENV=test bun test src/__tests__/lifecycle.gracefulShutdown.test.ts --timeout=30000",
    "core:shadow": "NODE_ENV=test SENTRY_DSN= PORT=0 bun --watch src/core/shadow.ts",
    "core:candidate": "NODE_ENV=test SENTRY_DSN= PORT=0 bun --watch src/core/index.ts",
    "core:smoke": "bun scripts/core-entry-smoke.ts",
    "core:production-smoke": "bun scripts/core-production-smoke.ts",
    "core:artifact-smoke": "bun run build && bun scripts/core-production-smoke.ts --artifact",
    "core:http-smoke": "NODE_ENV=test bun scripts/core-http-kernel-smoke.ts",
    "typecheck": "tsc --build",
    "typecheck:effect": "tsc --build tsconfig.effect.json",
    "db:migrate": "bun scripts/migrate.ts",
    "db:dangerously-reset-db": "bun scripts/reset-db.ts",
    "db:generate": "drizzle-kit generate --schema src/db/schema/index.ts --out drizzle --dialect postgresql --name",
    "db:push": "drizzle-kit push --schema src/db/schema/index.ts --dialect postgresql",
    "db:drop": "drizzle-kit drop --out drizzle",
    "db:studio": "drizzle-kit studio --port 8010 --schema src/db/schema/index.ts --out drizzle --dialect postgresql",
    "drizzle:up": "drizzle-kit up --dialect=postgresql",
    "livekit:cutover-preflight": "bun scripts/livekit-cutover-preflight.ts",
    "lint": "oxlint --config ../.oxlintrc.json --ignore-path ../.oxlintignore --ignore-pattern 'scripts/lint/fixtures/**'",
    "lint:strict": "oxlint --config ../.oxlintrc.json --ignore-path ../.oxlintignore --deny-warnings --report-unused-disable-directives src/core src/**/*.effect.ts src/**/*.effect.test.ts src/**/*.effect.spec.ts src/modules/effect src/db/models/members/deleteMember.ts src/__tests__/contracts scripts/contracts scripts/core-entry-smoke.ts scripts/core-http-kernel-smoke.ts scripts/core-production-smoke.ts scripts/test-runner.ts vitest.effect.config.ts",
    "lint:rules": "bun test scripts/lint/oxlint-plugin-inline-effect.test.ts",
    "lint:fix": "oxlint --config ../.oxlintrc.json --ignore-path ../.oxlintignore --ignore-pattern 'scripts/lint/fixtures/**' --fix",
    "contracts:routes": "NODE_ENV=test bun scripts/contracts/route-manifest.ts",
    "contracts:routes:update": "NODE_ENV=test bun scripts/contracts/route-manifest.ts --write",
    "contracts:openapi": "NODE_ENV=test bun scripts/contracts/openapi-manifest.ts",
    "contracts:openapi:update": "NODE_ENV=test bun scripts/contracts/openapi-manifest.ts --write",
    "container:build": "docker build -f Dockerfile .."
  },
  "overrides": {
    "elysia": "=1.4.29",
    "@sinclair/typebox": "=0.34.49"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.38.0",
    "@aws-sdk/client-sesv2": "^3.675.0",
    "@bufbuild/protobuf": "^2.2.3",
    "@effect/platform-bun": "catalog:",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/html": "1.4.2",
    "@elysiajs/swagger": "1.3.1",
    "@inline-chat/bot-api-types": "workspace:*",
    "@inline-chat/email-templates": "workspace:*",
    "@inline-chat/oauth-core": "workspace:*",
    "@inline-chat/protocol": "workspace:*",
    "@inline-chat/url-preview": "workspace:*",
    "@linear/sdk": "^38.0.0",
    "@notionhq/client": "5.11.0",
    "@prelude.so/sdk": "^0.3.0",
    "@protobuf-ts/plugin": "^2.9.4",
    "@protobuf-ts/runtime": "^2.11.1",
    "@react-email/components": "^1.0.6",
    "@react-email/render": "^2.0.4",
    "@sentry/bun": "10",
    "@sinclair/typebox": "=0.34.49",
    "apn": "^2.2.0",
    "arctic": "^3.3.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "1.0.0-beta.1-c0277c0",
    "drizzle-orm": "1.0.0-beta.1-c0277c0",
    "effect": "catalog:",
    "elysia": "=1.4.29",
    "elysia-helmet": "3.1.0",
    "elysia-rate-limit": "4.6.2",
    "expo-server-sdk": "6.1.0",
    "libphonenumber-js": "^1.12.7",
    "livekit-server-sdk": "2.17.0",
    "nanoid": "^5.0.7",
    "nanoid-dictionary": "^4.3.0",
    "openai": "7.1.0",
    "postgres": "^3.4.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^4.0.0",
    "sharp": "^0.33.5",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/nanoid-dictionary": "^4.2.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
