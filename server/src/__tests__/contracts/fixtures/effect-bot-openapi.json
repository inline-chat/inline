ken>/sendMessage' \\\n  -d '{\"chat_id\": 42, \"text\": \"hello from bot\"}'\n```\n\nTargeting: use `chat_id` for chats/threads or `user_id` for DMs.\n\nErrors return `{ \"ok\": false, \"error_code\": <http status>, \"description\": \"...\" }`; `error` may be present as a machine-readable code.\n\n### Quick check\n\n```bash\ncurl -sS 'https://api.inline.chat/bot<token>/getMe'\n```","termsOfService":"https://inline.chat/terms","title":"Inline Bot HTTP API Docs","version":"0.0.1"},"openapi":"3.1.0","paths":{"/bot/deleteMessage":{"post":{"description":"Returns the compact Inline Bot API envelope. POST query parameters are accepted for compatibility; JSON is recommended.","operationId":"bot.headerDeleteMessage","parameters":[{"in":"header","name":"authorization","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteMessageInput"}}},"required":false},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BotEmptySuccess"}}},"description":"BotEmptySuccess"},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BotApiError"}}},"description":"BotApiError"},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BotApiError1"}}},"description":"BotApiError"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BotApiError2"}}},"description":"BotApiError"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BotApiError3"}}},"description":"BotApiError"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BotApiError4"}}},"description":"BotApiError"}},"security":[],"summary":"Delete a message","tags":["Bot"]}},"/bot/deleteMyCommands":{"post":{"description":"Returns the compact Inline Bot API envelope. POST query parameters are accepted for compatibility; JSON is recommended.","operationId":"bot.headerDeleteMyCommands","parameters":[{"in":"header",