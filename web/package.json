{
  "name": "@inline-chat/web",
  "productName": "Inline",
  "description": "Inline for web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": "^20.20.0 || ^22.0.0 || ^24.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 8001",
    "build": "vite build",
    "benchmark:message-window": "bun tests/performance/benchmark-message-window.ts",
    "benchmark:message-window:browser": "bun tests/performance/run-message-window-benchmark.ts",
    "acceptance:real-account": "bun tooling/record-real-account-acceptance.ts",
    "acceptance:real-transaction": "bun tooling/acceptance/record-real-account-transaction.ts",
    "smoke:message-list:browser": "bun tests/browser/run-message-list-smoke.ts",
    "smoke:media-cache:browser": "bun tests/browser/run-media-cache-smoke.ts",
    "smoke:core-broadcast:browser": "bun tests/browser/run-broadcast-core-smoke.ts",
    "smoke:core-failure:browser": "bun tests/browser/run-core-failure-smoke.ts",
    "smoke:auth-session:browser": "bun tests/browser/run-auth-session-smoke.ts",
    "smoke:sqlite-worker:browser": "bun tests/browser/run-sqlite-worker-smoke.ts",
    "smoke:sqlite-crash:browser": "bun tests/browser/run-sqlite-crash-smoke.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:packages && bun run test:all && bun run test:browser:core && bun run test:browser:message-list && bun run test:browser:compose && bun run test:browser:media && bun run test:browser:product && bun run build",
    "preview": "vite preview --port 8001",
    "start": "vite preview --host 127.0.0.1 --port 8001",
    "typecheck": "bun tooling/typecheck.ts",
    "typecheck:packages": "bun run --cwd packages/ids typecheck && bun run --cwd packages/auth typecheck && bun run --cwd packages/client typecheck",
    "lint": "oxlint src tests tooling vite.config.ts vitest.config.ts playwright.config.ts",
    "lint:packages": "bun run --cwd packages/ids lint && bun run --cwd packages/auth lint && bun run --cwd packages/client lint",
    "test": "vitest run --config vitest.config.ts",
    "test:browser:core": "playwright test tests/browser/specs/core-owner.pw.ts tests/browser/specs/core-recovery.pw.ts",
    "test:browser:message-list": "playwright test tests/browser/specs/message-list.pw.ts",
    "test:browser:compose": "playwright test tests/browser/specs/compose.pw.ts",
    "test:browser:media": "playwright test tests/browser/specs/media-viewer.pw.ts",
    "test:browser:product": "playwright test tests/browser/specs/product-first-frame.pw.ts",
    "test:browser:performance": "playwright test tests/browser/specs/message-window-performance.pw.ts",
    "test:packages": "bun run --cwd packages/ids test && bun run --cwd packages/auth test && bun run --cwd packages/client test",
    "test:all": "bun run test && bun run test:packages"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@inline-chat/protocol": "workspace:*",
    "@inline/client": "workspace:*",
    "@inline/config": "workspace:*",
    "@inline/ids": "workspace:*",
    "@lexical/react": "0.44.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "lexical": "0.44.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "virtua": "^0.49.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.3.0",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vitest": "catalog:"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ]
}
