{
  "name": "@inline/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./react": {
      "types": "./src/react/index.tsx",
      "default": "./src/react/index.tsx"
    },
    "./sqlite": {
      "types": "./src/database/sqlite/index.ts",
      "default": "./src/database/sqlite/index.ts"
    }
  },
  "scripts": {
    "lint": "oxlint --ignore-path ../../../.oxlintignore src vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inline-chat/protocol": "workspace:*",
    "@inline/auth": "workspace:*",
    "@inline/config": "workspace:*",
    "@inline/ids": "workspace:*",
    "@inline/log": "workspace:*",
    "@msgpack/msgpack": "3.1.3",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
